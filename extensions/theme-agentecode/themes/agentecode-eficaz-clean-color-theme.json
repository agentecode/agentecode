    "statusBarItem.warningForeground": "#869cae"
  },
  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#869cae",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palavras-chave e Modificadores",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#3cdbc0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings e Textos",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7fe7d6"
      }
    },
    {
      "name": "Números e Valores Literais",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#e5a869"
      }
    },
    {
      "name": "Funções e Métodos",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#5cb7f8"
      }
    },
    {
      "name": "Classes, Tipos e Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#f3ca68",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variáveis e Parâmetros",
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e2edf5"
      }
    },
    {
      "name": "Propriedades e Chaves de Objeto",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#86d9ce"
      }
    },
    {
      "name": "Tags HTML / JSX / Delimitadores de Código",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#5cb7f8"
      }
    },
    {
      "name": "Atributos HTML / XML",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f3ca68"
      }
    },
    {
      "name": "Pontuações e Delimitadores (Brackets)",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.brackets",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#869cae"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": "#3cdbc0",
    "class": {
      "foreground": "#f3ca68",
      "bold": true
    },
    "interface": "#3cdbc0",
    "struct": "#3cdbc0",
    "enum": "#f3ca68",
    "enumMember": "#5cb7f8",
    "function": "#5cb7f8",
    "method": "#5cb7f8",
    "property": "#5cb7f8",
    "variable": "#e2edf5",
    "parameter": "#869cae",
    "string": "#7fe7d6",
    "number": "#e5a869",
    "comment": {
      "foreground": "#869cae",
      "italic": true
    }
  }
}
