{
  "name": "agentecode-core",
  "displayName": "AgenteCode Core",
  "description": "%description%",
  "version": "1.0.14",
  "publisher": "agentecode",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentecode.exportSessionToMarkdown",
    "onCommand:agentecode.undoLastRewind",
    "onCommand:agentecode.showReleaseNotes",
    "onCommand:agentecode.usage.history",
    "onCommand:agentecode.sync.menu",
    "onCommand:agentecode.sync.connect",
    "onCommand:agentecode.sync.upload",
    "onCommand:agentecode.sync.download",
    "onCommand:agentecode.sync.copyGistUrl",
    "onCommand:agentecode.sync.openGist",
    "onCommand:agentecode.sync.toggleAuto",
    "onCommand:agentecode.sync.undoLast",
    "onCommand:agentecode.sync.disconnect",
    "onCommand:agentecode.sync.guide",
    "onView:agentecode.sessions",
    "onView:agentecode.review",
    "onView:agentecode.reviewPanel"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configurationDefaults": {
      "claudeCode.preferredLocation": "sidebar"
    },
    "commands": [
      {
        "command": "agentecode.exportSessionToMarkdown",
        "title": "%command.exportSession.title%",
        "category": "AgenteCode",
        "icon": "$(export)"
      },
      {
        "command": "agentecode.undoLastRewind",
        "title": "%command.undoLastRewind.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.sessions.refresh",
        "title": "%command.sessions.refresh.title%",
        "category": "AgenteCode",
        "icon": "$(refresh)"
      },
      {
        "command": "agentecode.sessions.search",
        "title": "%command.sessions.search.title%",
        "category": "AgenteCode",
        "icon": "$(search)"
      },
      {
        "command": "agentecode.sessions.clearSearch",
        "title": "%command.sessions.clearSearch.title%",
        "category": "AgenteCode",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentecode.sessions.resume",
        "title": "%command.sessions.resume.title%",
        "category": "AgenteCode",
        "icon": "$(play)"
      },
      {
        "command": "agentecode.sessions.delete",
        "title": "%command.sessions.delete.title%",
        "category": "AgenteCode",
        "icon": "$(trash)"
      },
      {
        "command": "agentecode.sessions.rewind",
        "title": "%command.sessions.rewind.title%",
        "category": "AgenteCode",
        "icon": "$(discard)"
      },
      {
        "command": "agentecode.showReleaseNotes",
        "title": "%command.showReleaseNotes.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.refresh",
        "title": "%command.review.refresh.title%",
        "category": "AgenteCode",
        "icon": "$(refresh)"
      },
      {
        "command": "agentecode.review.open",
        "title": "%command.review.open.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.keep",
        "title": "%command.review.keep.title%",
        "category": "AgenteCode",
        "icon": "$(check)"
      },
      {
        "command": "agentecode.review.keepAll",
        "title": "%command.review.keepAll.title%",
        "category": "AgenteCode",
        "icon": "$(check-all)"
      },
      {
        "command": "agentecode.review.revert",
        "title": "%command.review.revert.title%",
        "category": "AgenteCode",
        "icon": "$(discard)"
      },
      {
        "command": "agentecode.review.revertAll",
        "title": "%command.review.revertAll.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.toggleReviewed",
        "title": "%command.review.toggleReviewed.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.clearReviewed",
        "title": "%command.review.clearReviewed.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.chooseSession",
        "title": "%command.review.chooseSession.title%",
        "category": "AgenteCode",
        "icon": "$(history)"
      },
      {
        "command": "agentecode.review.forSession",
        "title": "%command.review.forSession.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.keepHunkAtCursor",
        "title": "%command.review.keepHunkAtCursor.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.undoHunkAtCursor",
        "title": "%command.review.undoHunkAtCursor.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.chooseBase",
        "title": "%command.review.chooseBase.title%",
        "category": "AgenteCode",
        "icon": "$(git-compare)"
      },
      {
        "command": "agentecode.usage.history",
        "title": "%command.usage.history.title%",
        "category": "AgenteCode",
        "icon": "$(graph)"
      },
      {
        "command": "claudeUsageBar.refresh",
        "title": "%command.usageBar.refresh.title%"
      },
      {
        "command": "claudeUsageBar.toggle",
        "title": "%command.usageBar.toggle.title%"
      },
      {
        "command": "claudeUsageBar.openPanel",
        "title": "%command.usageBar.openPanel.title%"
      },
      {
        "command": "claudeUsageBar.enableDirect",
        "title": "%command.usageBar.enableDirect.title%"
      },
      {
        "command": "agentecode.sync.menu",
        "title": "%command.sync.menu.title%",
        "category": "AgenteCode",
        "icon": "$(sync)"
      },
      {
        "command": "agentecode.sync.connect",
        "title": "%command.sync.connect.title%",
        "category": "AgenteCode",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentecode.sync.upload",
        "title": "%command.sync.upload.title%",
        "category": "AgenteCode",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentecode.sync.download",
        "title": "%command.sync.download.title%",
        "category": "AgenteCode",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentecode.sync.copyGistUrl",
        "title": "%command.sync.copyGistUrl.title%",
        "category": "AgenteCode",
        "icon": "$(copy)"
      },
      {
        "command": "agentecode.sync.openGist",
        "title": "%command.sync.openGist.title%",
        "category": "AgenteCode",
        "icon": "$(globe)"
      },
      {
        "command": "agentecode.sync.toggleAuto",
        "title": "%command.sync.toggleAuto.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.sync.undoLast",
        "title": "%command.sync.undoLast.title%",
        "category": "AgenteCode",
        "icon": "$(discard)"
      },
      {
        "command": "agentecode.sync.disconnect",
        "title": "%command.sync.disconnect.title%",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.sync.guide",
        "title": "%command.sync.guide.title%",
        "category": "AgenteCode",
        "icon": "$(book)"
      }
    ],
    "configuration": {
      "title": "AgenteCode",
      "properties": {
        "agentecode.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-BR"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.pt-BR%"
          ],
          "description": "%config.language.description%"
        },
        "agentecode.export.includeToolResults": {
          "type": "boolean",
          "default": true,
          "description": "%config.export.includeToolResults.description%"
        },
        "agentecode.export.maxToolResultChars": {
          "type": "number",
          "default": 1500,
          "minimum": 0,
          "description": "%config.export.maxToolResultChars.description%"
        },
        "agentecode.sessions.resumeLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "default": "sidebar",
          "enumDescriptions": [
            "%config.sessions.resumeLocation.sidebar%",
            "%config.sessions.resumeLocation.editor%"
          ],
          "description": "%config.sessions.resumeLocation.description%"
        },
        "agentecode.releaseNotes.show": {
          "type": "boolean",
          "default": true,
          "description": "%config.releaseNotes.show.description%"
        },
        "claudeUsageBar.contextWindow": {
          "type": "number",
          "default": 0,
          "description": "%config.usageBar.contextWindow.description%"
        },
        "claudeUsageBar.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageBar.showStatusBar.description%"
        },
        "claudeUsageBar.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "%config.usageBar.refreshSeconds.description%"
        },
        "claudeUsageBar.showCost": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageBar.showCost.description%"
        },
        "claudeUsageBar.showTurn": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageBar.showTurn.description%"
        },
        "claudeUsageBar.showSessionTime": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageBar.showSessionTime.description%"
        },
        "claudeUsageBar.showLimits": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageBar.showLimits.description%"
        },
        "claudeUsageBar.limitsStaleMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "%config.usageBar.limitsStaleMinutes.description%"
        },
        "claudeUsageBar.limitsSnapshotPath": {
          "type": "string",
          "default": "",
          "description": "%config.usageBar.limitsSnapshotPath.description%"
        },
        "claudeUsageBar.colorSession5h": {
          "type": "string",
          "default": "charts.green",
          "description": "%config.usageBar.colorSession5h.description%"
        },
        "claudeUsageBar.colorWeekly7d": {
          "type": "string",
          "default": "charts.green",
          "description": "%config.usageBar.colorWeekly7d.description%"
        },
        "claudeUsageBar.refreshLimits": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageBar.refreshLimits.description%"
        },
        "claudeUsageBar.fetchLimitsDirectly": {
          "type": "boolean",
          "default": false,
          "description": "%config.usageBar.fetchLimitsDirectly.description%"
        },
        "claudeUsageBar.directRefreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 3,
          "description": "%config.usageBar.directRefreshMinutes.description%"
        },
        "claudeUsageBar.activeRefreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "description": "%config.usageBar.activeRefreshSeconds.description%"
        },
        "claudeUsageBar.colorGradient": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageBar.colorGradient.description%"
        },
        "claudeUsageBar.colorGradientStart": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.usageBar.colorGradientStart.description%"
        },
        "claudeUsageBar.colorGradientAmber": {
          "type": "number",
          "default": 75,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.usageBar.colorGradientAmber.description%"
        },
        "claudeUsageBar.colorGradientRed": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.usageBar.colorGradientRed.description%"
        },
        "agentecode.sync.auto": {
          "type": "boolean",
          "default": true,
          "description": "%config.sync.auto.description%"
        },
        "agentecode.sync.autoDelaySeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "description": "%config.sync.autoDelaySeconds.description%"
        },
        "agentecode.sync.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.sync.checkOnStartup.description%"
        },
        "agentecode.sync.excludedSettings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claudeCode.environmentVariables",
            "claudeCode.claudeProcessWrapper",
            "claudeUsageBar.limitsSnapshotPath",
            "git.path",
            "python.defaultInterpreterPath"
          ],
          "description": "%config.sync.excludedSettings.description%"
        },
        "agentecode.sync.syncSnippets": {
          "type": "boolean",
          "default": true,
          "description": "%config.sync.syncSnippets.description%"
        },
        "agentecode.sync.syncExtensions": {
          "type": "boolean",
          "default": true,
          "description": "%config.sync.syncExtensions.description%"
        },
        "agentecode.review.terminalChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.review.terminalChanges.description%"
        },
        "agentecode.review.panel": {
          "type": "string",
          "enum": [
            "webview",
            "tree"
          ],
          "enumDescriptions": [
            "%config.review.panel.webview%",
            "%config.review.panel.tree%"
          ],
          "default": "webview",
          "description": "%config.review.panel.description%"
        },
        "agentecode.review.inlineHint": {
          "type": "boolean",
          "default": false,
          "description": "%config.review.inlineHint.description%"
        },
        "agentecode.review.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "%config.review.codeLens.description%"
        },
        "agentecode.sync.syncClaudeConfig": {
          "type": "boolean",
          "default": false,
          "description": "%config.sync.syncClaudeConfig.description%"
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentecode-sessions",
          "title": "%container.sessions.title%",
          "icon": "media/sessions.svg"
        }
      ],
      "activitybar": [
        {
          "id": "claudeUsage",
          "title": "Claude Usage",
          "icon": "media/usage.svg",
          "when": "agentecode.usage.enabled"
        }
      ]
    },
    "views": {
      "agentecode-sessions": [
        {
          "id": "agentecode.sessions",
          "name": "%view.sessions.name%",
          "icon": "media/sessions.svg"
        },
        {
          "type": "webview",
          "id": "agentecode.reviewPanel",
          "name": "%view.review.name%",
          "icon": "media/sessions.svg",
          "when": "config.agentecode.review.panel != 'tree'"
        },
        {
          "id": "agentecode.review",
          "name": "%view.review.name%",
          "icon": "media/sessions.svg",
          "when": "config.agentecode.review.panel == 'tree'"
        }
      ],
      "claudeUsage": [
        {
          "type": "webview",
          "id": "claudeUsageBar.panel",
          "name": "%view.usagePanel.name%",
          "when": "agentecode.usage.enabled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentecode.sessions",
        "contents": "%welcome.sessions.contents%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentecode.review.open",
          "when": "false"
        },
        {
          "command": "agentecode.review.keep",
          "when": "false"
        },
        {
          "command": "agentecode.review.revert",
          "when": "false"
        },
        {
          "command": "agentecode.review.forSession",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.resume",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.clearSearch",
          "when": "agentecode.sessions.searching"
        },
        {
          "command": "claudeUsageBar.refresh",
          "when": "agentecode.usage.enabled"
        },
        {
          "command": "claudeUsageBar.toggle",
          "when": "agentecode.usage.enabled"
        },
        {
          "command": "claudeUsageBar.openPanel",
          "when": "agentecode.usage.enabled"
        },
        {
          "command": "claudeUsageBar.enableDirect",
          "when": "agentecode.usage.enabled"
        }
      ],
      "scm/title": [
        {
          "command": "agentecode.review.chooseBase",
          "when": "scmProvider == agentecode-review",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.review.keepAll",
          "when": "scmProvider == agentecode-review",
          "group": "navigation@2"
        },
        {
          "command": "agentecode.review.refresh",
          "when": "scmProvider == agentecode-review",
          "group": "navigation@3"
        },
        {
          "command": "agentecode.review.chooseSession",
          "when": "scmProvider == agentecode-review",
          "group": "1_review@1"
        },
        {
          "command": "agentecode.review.revertAll",
          "when": "scmProvider == agentecode-review",
          "group": "1_review@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "agentecode.review.keep",
          "when": "scmProvider == agentecode-review && scmResourceGroup == changes",
          "group": "inline@1"
        },
        {
          "command": "agentecode.review.revert",
          "when": "scmProvider == agentecode-review && scmResourceGroup == changes",
          "group": "inline@2"
        }
      ],
      "view/title": [
        {
          "command": "agentecode.review.chooseBase",
          "when": "view == agentecode.review",
          "group": "navigation@0"
        },
        {
          "command": "agentecode.review.chooseSession",
          "when": "view == agentecode.review",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.review.keepAll",
          "when": "view == agentecode.review",
          "group": "navigation@2"
        },
        {
          "command": "agentecode.review.refresh",
          "when": "view == agentecode.review",
          "group": "navigation@3"
        },
        {
          "command": "agentecode.review.revertAll",
          "when": "view == agentecode.review",
          "group": "1_review@1"
        },
        {
          "command": "agentecode.review.toggleReviewed",
          "when": "view == agentecode.review",
          "group": "1_review@2"
        },
        {
          "command": "agentecode.review.clearReviewed",
          "when": "view == agentecode.review",
          "group": "1_review@3"
        },
        {
          "command": "agentecode.usage.history",
          "when": "view == claudeUsageBar.panel",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.sessions.search",
          "when": "view == agentecode.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.sessions.clearSearch",
          "when": "view == agentecode.sessions && agentecode.sessions.searching",
          "group": "navigation@2"
        },
        {
          "command": "agentecode.sessions.refresh",
          "when": "view == agentecode.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentecode.review.keep",
          "when": "view == agentecode.review && viewItem == reviewFile",
          "group": "inline@1"
        },
        {
          "command": "agentecode.review.revert",
          "when": "view == agentecode.review && viewItem == reviewFile",
          "group": "inline@2"
        },
        {
          "command": "agentecode.review.forSession",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "2_review@1"
        },
        {
          "command": "agentecode.sessions.resume",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "agentecode.exportSessionToMarkdown",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@3"
        },
        {
          "command": "agentecode.sessions.resume",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "1_actions@1"
        },
        {
          "command": "agentecode.exportSessionToMarkdown",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "1_actions@2"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "9_danger@1"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "view == agentecode.sessions && viewItem == checkpoint",
          "group": "inline@1"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "view == agentecode.sessions && viewItem == checkpoint",
          "group": "1_actions@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentecode.sessions.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == agentecode.sessions"
      }
    ]
  }
}
