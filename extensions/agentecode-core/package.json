{
  "name": "agentecode-core",
  "displayName": "AgenteCode Core",
  "description": "Recursos próprios do AgenteCode: histórico de sessões do agente, volta de arquivos (checkpoint), exportação para Markdown e notas de versão.",
  "version": "1.0.8",
  "publisher": "agentecode",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentecode.exportSessionToMarkdown",
    "onCommand:agentecode.undoLastRewind",
    "onCommand:agentecode.showReleaseNotes",
    "onCommand:agentecode.usage.history",
    "onCommand:agentecode.sync.menu",
    "onCommand:agentecode.sync.connect",
    "onCommand:agentecode.sync.upload",
    "onCommand:agentecode.sync.download",
    "onCommand:agentecode.sync.copyGistUrl",
    "onCommand:agentecode.sync.openGist",
    "onCommand:agentecode.sync.toggleAuto",
    "onCommand:agentecode.sync.undoLast",
    "onCommand:agentecode.sync.disconnect",
    "onCommand:agentecode.sync.guide",
    "onView:agentecode.sessions",
    "onView:agentecode.review",
    "onView:agentecode.reviewPanel"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configurationDefaults": {
      "editor.codeLensFontSize": 13
    },
    "commands": [
      {
        "command": "agentecode.exportSessionToMarkdown",
        "title": "Exportar sessão do agente para Markdown",
        "category": "AgenteCode",
        "icon": "$(export)"
      },
      {
        "command": "agentecode.undoLastRewind",
        "title": "Desfazer a última volta de arquivos",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.sessions.refresh",
        "title": "Atualizar sessões",
        "category": "AgenteCode",
        "icon": "$(refresh)"
      },
      {
        "command": "agentecode.sessions.search",
        "title": "Buscar nas sessões do agente",
        "category": "AgenteCode",
        "icon": "$(search)"
      },
      {
        "command": "agentecode.sessions.clearSearch",
        "title": "Limpar busca de sessões",
        "category": "AgenteCode",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentecode.sessions.resume",
        "title": "Retomar sessão no Claude Code",
        "category": "AgenteCode",
        "icon": "$(play)"
      },
      {
        "command": "agentecode.sessions.delete",
        "title": "Excluir sessão (Lixeira)",
        "category": "AgenteCode",
        "icon": "$(trash)"
      },
      {
        "command": "agentecode.sessions.rewind",
        "title": "Voltar arquivos para antes desta resposta",
        "category": "AgenteCode",
        "icon": "$(discard)"
      },
      {
        "command": "agentecode.showReleaseNotes",
        "title": "Mostrar notas da versão",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.refresh",
        "title": "Atualizar alterações do agente",
        "category": "AgenteCode",
        "icon": "$(refresh)"
      },
      {
        "command": "agentecode.review.open",
        "title": "Ver diferença",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.keep",
        "title": "Marcar como revisado",
        "category": "AgenteCode",
        "icon": "$(check)"
      },
      {
        "command": "agentecode.review.keepAll",
        "title": "Marcar tudo como revisado",
        "category": "AgenteCode",
        "icon": "$(check-all)"
      },
      {
        "command": "agentecode.review.revert",
        "title": "Voltar este arquivo para antes da conversa",
        "category": "AgenteCode",
        "icon": "$(discard)"
      },
      {
        "command": "agentecode.review.revertAll",
        "title": "Voltar todos os arquivos para antes da conversa",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.toggleReviewed",
        "title": "Mostrar ou ocultar arquivos já revisados",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.clearReviewed",
        "title": "Limpar a lista de revisados",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.chooseSession",
        "title": "Escolher a conversa a revisar",
        "category": "AgenteCode",
        "icon": "$(history)"
      },
      {
        "command": "agentecode.review.forSession",
        "title": "Revisar alterações desta conversa",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.keepHunkAtCursor",
        "title": "Manter o trecho alterado pelo agente sob o cursor",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.undoHunkAtCursor",
        "title": "Desfazer o trecho alterado pelo agente sob o cursor",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.review.chooseBase",
        "title": "Comparar alterações com o estado de antes de um turno",
        "category": "AgenteCode",
        "icon": "$(git-compare)"
      },
      {
        "command": "agentecode.usage.history",
        "title": "Histórico de uso e custo",
        "category": "AgenteCode",
        "icon": "$(graph)"
      },
      {
        "command": "claudeUsageBar.refresh",
        "title": "Claude Usage: Atualizar agora"
      },
      {
        "command": "claudeUsageBar.toggle",
        "title": "Claude Usage: Mostrar/ocultar barra"
      },
      {
        "command": "claudeUsageBar.openPanel",
        "title": "Claude Usage: Abrir/fechar painel de uso"
      },
      {
        "command": "claudeUsageBar.enableDirect",
        "title": "Claude Usage: Ativar limites 5h/7d (consulta à API de uso)"
      },
      {
        "command": "agentecode.sync.menu",
        "title": "Sincronizar configurações com o GitHub...",
        "category": "AgenteCode",
        "icon": "$(sync)"
      },
      {
        "command": "agentecode.sync.connect",
        "title": "Sincronização: Conectar e enviar",
        "category": "AgenteCode",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentecode.sync.upload",
        "title": "Sincronização: Enviar agora",
        "category": "AgenteCode",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentecode.sync.download",
        "title": "Sincronização: Baixar do GitHub",
        "category": "AgenteCode",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentecode.sync.copyGistUrl",
        "title": "Sincronização: Copiar URL do Gist",
        "category": "AgenteCode",
        "icon": "$(copy)"
      },
      {
        "command": "agentecode.sync.openGist",
        "title": "Sincronização: Abrir Gist no navegador",
        "category": "AgenteCode",
        "icon": "$(globe)"
      },
      {
        "command": "agentecode.sync.toggleAuto",
        "title": "Sincronização: Alternar envio automático",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.sync.undoLast",
        "title": "Sincronização: Desfazer última sincronização",
        "category": "AgenteCode",
        "icon": "$(discard)"
      },
      {
        "command": "agentecode.sync.disconnect",
        "title": "Sincronização: Desconectar",
        "category": "AgenteCode"
      },
      {
        "command": "agentecode.sync.guide",
        "title": "Sincronização: Ver guia",
        "category": "AgenteCode",
        "icon": "$(book)"
      }
    ],
    "configuration": {
      "title": "AgenteCode",
      "properties": {
        "agentecode.export.includeToolResults": {
          "type": "boolean",
          "default": true,
          "description": "Inclui, de forma resumida, a saída das ferramentas (comandos, leitura de arquivos) na exportação da sessão para Markdown."
        },
        "agentecode.export.maxToolResultChars": {
          "type": "number",
          "default": 1500,
          "minimum": 0,
          "description": "Tamanho máximo, em caracteres, de cada saída de ferramenta incluída na exportação."
        },
        "agentecode.sessions.resumeLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "default": "sidebar",
          "enumDescriptions": [
            "No Claude Code do painel lateral direito (integrado).",
            "Em uma nova aba do editor."
          ],
          "description": "Onde o botão Retomar do painel de sessões abre a conversa."
        },
        "agentecode.releaseNotes.show": {
          "type": "boolean",
          "default": true,
          "description": "Abre as novidades na primeira vez que o AgenteCode inicia depois de uma atualização."
        },
        "claudeUsageBar.contextWindow": {
          "type": "number",
          "default": 0,
          "description": "Janela de contexto em tokens. 0 = automático pelo modelo (1M para a família 5, 200k para modelos antigos)."
        },
        "claudeUsageBar.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Mostra os itens na barra de status. Desligue se preferir ver o uso só acima do chat (plugin usage-band) ou só no painel lateral."
        },
        "claudeUsageBar.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Intervalo de atualização, em segundos."
        },
        "claudeUsageBar.showCost": {
          "type": "boolean",
          "default": true,
          "description": "Mostra o custo estimado da sessão (calculado pela tabela de preços da API)."
        },
        "claudeUsageBar.showTurn": {
          "type": "boolean",
          "default": true,
          "description": "Mostra a duração do último turno."
        },
        "claudeUsageBar.showSessionTime": {
          "type": "boolean",
          "default": true,
          "description": "Mostra o tempo desde o início da sessão."
        },
        "claudeUsageBar.showLimits": {
          "type": "boolean",
          "default": true,
          "description": "Mostra os limites de 5h e 7d na barra."
        },
        "claudeUsageBar.limitsStaleMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Idade máxima, em minutos, da leitura dos limites; acima disso eles deixam de ser exibidos. Leituras com mais de 10 min mostram a idade."
        },
        "claudeUsageBar.limitsSnapshotPath": {
          "type": "string",
          "default": "",
          "description": "Caminho do usage-snapshot.json da extensão opcional claude-usage-meter. Vazio = ~/.claude-usage-meter/usage-snapshot.json."
        },
        "claudeUsageBar.colorSession5h": {
          "type": "string",
          "default": "charts.green",
          "description": "Cor do limite de 5h na barra e no painel: id de cor do tema (charts.green, acompanha o tema) ou hexadecimal (#7fbbb3). Vazio = cor padrão da barra."
        },
        "claudeUsageBar.colorWeekly7d": {
          "type": "string",
          "default": "charts.green",
          "description": "Cor-base do limite de 7d na barra e no painel (até o degradê começar): id de cor do tema (charts.green, acompanha o tema) ou hexadecimal (#7fbbb3). Vazio = cor padrão da barra."
        },
        "claudeUsageBar.refreshLimits": {
          "type": "boolean",
          "default": true,
          "description": "Se a extensão opcional claude-usage-meter estiver ativa e a consulta direta desligada, pede a ela uma leitura nova quando a atual tem mais de 6 min."
        },
        "claudeUsageBar.fetchLimitsDirectly": {
          "type": "boolean",
          "default": false,
          "description": "Obtém os limites 5h/7d consultando https://api.anthropic.com/api/oauth/usage (endpoint não documentado). Lê o token do Claude Code (~/.claude/.credentials.json; no macOS, o Keychain) somente para essa consulta; várias janelas dividem uma única consulta por intervalo. É ativada pelo aviso na primeira execução ou pelo comando \"Claude Usage: Ativar limites 5h/7d\"."
        },
        "claudeUsageBar.directRefreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 3,
          "description": "Intervalo, em minutos, da consulta dos limites quando o Claude está parado (com recuo automático em caso de limitação da API)."
        },
        "claudeUsageBar.activeRefreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "description": "Enquanto o Claude está sendo usado, consulta os limites com este espaçamento mínimo, em segundos (no máximo uma consulta por computador nesse intervalo)."
        },
        "claudeUsageBar.colorGradient": {
          "type": "boolean",
          "default": true,
          "description": "Muda a cor dos limites 5h e 7d e do contexto aos poucos, da cor-base até o vermelho, conforme o uso sobe (veja colorGradientStart, colorGradientAmber e colorGradientRed). Desligado, a cor é fixa e só troca no alerta."
        },
        "claudeUsageBar.colorGradientStart": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 100,
          "description": "Uso (%) a partir do qual a cor começa a sair da cor-base em direção ao âmbar. O contexto, que não tem cor-base, só começa a colorir no âmbar."
        },
        "claudeUsageBar.colorGradientAmber": {
          "type": "number",
          "default": 75,
          "minimum": 0,
          "maximum": 100,
          "description": "Uso (%) em que a cor chega ao âmbar, a meio caminho do vermelho."
        },
        "claudeUsageBar.colorGradientRed": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 100,
          "description": "Uso (%) a partir do qual a cor é vermelha e o alerta de fundo da barra é ligado. Precisa ser maior que o âmbar, que precisa ser maior que o início; fora de ordem valem 50, 75 e 90."
        },
        "agentecode.sync.auto": {
          "type": "boolean",
          "default": true,
          "description": "Envia alterações locais automaticamente após alguns segundos de inatividade (somente enquanto conectado)."
        },
        "agentecode.sync.autoDelaySeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "description": "Tempo de espera em segundos após a última alteração antes de disparar o envio automático."
        },
        "agentecode.sync.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Verifica se há atualizações remotas no Gist ao iniciar o AgenteCode."
        },
        "agentecode.sync.excludedSettings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claudeCode.environmentVariables",
            "claudeCode.claudeProcessWrapper",
            "claudeUsageBar.limitsSnapshotPath",
            "git.path",
            "python.defaultInterpreterPath"
          ],
          "description": "Chaves de configuração que nunca serão enviadas ao Gist (chaves contendo tokens, senhas ou segredos são ignoradas automaticamente)."
        },
        "agentecode.sync.syncSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Inclui trechos de código (snippets) do usuário na sincronização."
        },
        "agentecode.sync.syncExtensions": {
          "type": "boolean",
          "default": true,
          "description": "Inclui a lista de extensões instaladas pelo usuário na sincronização."
        },
        "agentecode.review.panel": {
          "type": "string",
          "enum": [
            "webview",
            "tree"
          ],
          "enumDescriptions": [
            "Tela própria, com botões Aceitar e Descartar, selos, números coloridos e trechos expansíveis.",
            "Lista nativa do VS Code (mais simples)."
          ],
          "default": "webview",
          "description": "Como a lista \"Alterações do agente\" é desenhada na barra lateral."
        },
        "agentecode.review.inlineHint": {
          "type": "boolean",
          "default": false,
          "description": "Mostra também, no fim da primeira linha de cada trecho alterado pelo agente, um rótulo em itálico com os atalhos Alt+Y (manter) e Alt+N (desfazer). Os botões acima do trecho já trazem os atalhos na dica."
        },
        "agentecode.review.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Mostra Manter e Desfazer acima de cada trecho que o agente alterou, dentro do arquivo."
        },
        "agentecode.sync.syncClaudeConfig": {
          "type": "boolean",
          "default": false,
          "description": "Inclui na sincronização o CLAUDE.md global e os arquivos de ~/.claude/commands, agents e skills (somente texto; arquivos com chaves ou tokens são pulados)."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentecode-sessions",
          "title": "Sessões do agente",
          "icon": "media/sessions.svg"
        }
      ],
      "activitybar": [
        {
          "id": "claudeUsage",
          "title": "Claude Usage",
          "icon": "media/usage.svg",
          "when": "agentecode.usage.enabled"
        }
      ]
    },
    "views": {
      "agentecode-sessions": [
        {
          "id": "agentecode.sessions",
          "name": "Histórico de sessões",
          "icon": "media/sessions.svg"
        },
        {
          "type": "webview",
          "id": "agentecode.reviewPanel",
          "name": "Alterações do agente",
          "icon": "media/sessions.svg",
          "when": "config.agentecode.review.panel != 'tree'"
        },
        {
          "id": "agentecode.review",
          "name": "Alterações do agente",
          "icon": "media/sessions.svg",
          "when": "config.agentecode.review.panel == 'tree'"
        }
      ],
      "claudeUsage": [
        {
          "type": "webview",
          "id": "claudeUsageBar.panel",
          "name": "Uso do Claude",
          "when": "agentecode.usage.enabled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentecode.sessions",
        "contents": "Nenhuma sessão do agente encontrada para esta pasta.\nAbra o Claude Code (Ctrl+L) e converse para criar a primeira."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentecode.review.open",
          "when": "false"
        },
        {
          "command": "agentecode.review.keep",
          "when": "false"
        },
        {
          "command": "agentecode.review.revert",
          "when": "false"
        },
        {
          "command": "agentecode.review.forSession",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.resume",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "false"
        },
        {
          "command": "agentecode.sessions.clearSearch",
          "when": "agentecode.sessions.searching"
        },
        {
          "command": "claudeUsageBar.refresh",
          "when": "agentecode.usage.enabled"
        },
        {
          "command": "claudeUsageBar.toggle",
          "when": "agentecode.usage.enabled"
        },
        {
          "command": "claudeUsageBar.openPanel",
          "when": "agentecode.usage.enabled"
        },
        {
          "command": "claudeUsageBar.enableDirect",
          "when": "agentecode.usage.enabled"
        }
      ],
      "scm/title": [
        {
          "command": "agentecode.review.chooseBase",
          "when": "scmProvider == agentecode-review",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.review.keepAll",
          "when": "scmProvider == agentecode-review",
          "group": "navigation@2"
        },
        {
          "command": "agentecode.review.refresh",
          "when": "scmProvider == agentecode-review",
          "group": "navigation@3"
        },
        {
          "command": "agentecode.review.chooseSession",
          "when": "scmProvider == agentecode-review",
          "group": "1_review@1"
        },
        {
          "command": "agentecode.review.revertAll",
          "when": "scmProvider == agentecode-review",
          "group": "1_review@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "agentecode.review.keep",
          "when": "scmProvider == agentecode-review && scmResourceGroup == changes",
          "group": "inline@1"
        },
        {
          "command": "agentecode.review.revert",
          "when": "scmProvider == agentecode-review && scmResourceGroup == changes",
          "group": "inline@2"
        }
      ],
      "view/title": [
        {
          "command": "agentecode.review.chooseBase",
          "when": "view == agentecode.review",
          "group": "navigation@0"
        },
        {
          "command": "agentecode.review.chooseSession",
          "when": "view == agentecode.review",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.review.keepAll",
          "when": "view == agentecode.review",
          "group": "navigation@2"
        },
        {
          "command": "agentecode.review.refresh",
          "when": "view == agentecode.review",
          "group": "navigation@3"
        },
        {
          "command": "agentecode.review.revertAll",
          "when": "view == agentecode.review",
          "group": "1_review@1"
        },
        {
          "command": "agentecode.review.toggleReviewed",
          "when": "view == agentecode.review",
          "group": "1_review@2"
        },
        {
          "command": "agentecode.review.clearReviewed",
          "when": "view == agentecode.review",
          "group": "1_review@3"
        },
        {
          "command": "agentecode.usage.history",
          "when": "view == claudeUsageBar.panel",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.sessions.search",
          "when": "view == agentecode.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentecode.sessions.clearSearch",
          "when": "view == agentecode.sessions && agentecode.sessions.searching",
          "group": "navigation@2"
        },
        {
          "command": "agentecode.sessions.refresh",
          "when": "view == agentecode.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentecode.review.keep",
          "when": "view == agentecode.review && viewItem == reviewFile",
          "group": "inline@1"
        },
        {
          "command": "agentecode.review.revert",
          "when": "view == agentecode.review && viewItem == reviewFile",
          "group": "inline@2"
        },
        {
          "command": "agentecode.review.forSession",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "2_review@1"
        },
        {
          "command": "agentecode.sessions.resume",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "agentecode.exportSessionToMarkdown",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "inline@3"
        },
        {
          "command": "agentecode.sessions.resume",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "1_actions@1"
        },
        {
          "command": "agentecode.exportSessionToMarkdown",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "1_actions@2"
        },
        {
          "command": "agentecode.sessions.delete",
          "when": "view == agentecode.sessions && viewItem == session",
          "group": "9_danger@1"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "view == agentecode.sessions && viewItem == checkpoint",
          "group": "inline@1"
        },
        {
          "command": "agentecode.sessions.rewind",
          "when": "view == agentecode.sessions && viewItem == checkpoint",
          "group": "1_actions@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentecode.sessions.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == agentecode.sessions"
      }
    ],
    "configurationDefaults": {
      "claudeCode.preferredLocation": "sidebar"
    }
  }
}
